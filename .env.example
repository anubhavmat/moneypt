# MoneyPT settings. Copy this file to ".env" (same folder) and fill in your own values.
# NEVER share or commit your real .env. It holds secrets that unlock your bank connections.

# --- Required: encryption key for stored bank sign-in tokens -------------------------------------------
# Generate one with:  python -m ft.cli genkey   (run from the "src" folder), then paste the result here.
# Keep a copy somewhere safe. If you lose it, stored bank connections cannot be read and must be redone.
FT_ENCRYPTION_KEY=

# --- Where your data lives -----------------------------------------------------------------------------
# Full path to your database file. Set this so the app always finds the same data, wherever you start it from.
# Example (Windows): FT_DB_PATH=C:\Users\you\moneypt\finance.db
FT_DB_PATH=

# --- Bank connections via TrueLayer (optional: skip if you only use manual accounts) ---------------------
# Create your OWN free developer application at https://console.truelayer.com and add the redirect URI below to it.
# These identify your application. Never use anyone else's.
TL_ENV=sandbox
TL_CLIENT_ID=
TL_CLIENT_SECRET=
TL_REDIRECT_URI=http://localhost:3000/callback
# Optional: limit the bank picker to certain providers, e.g. uk-ob-natwest uk-ob-monzo
TL_PROVIDERS=

# --- Trading 212 (optional) ----------------------------------------------------------------------------
# Easiest: add keys in the dashboard (sidebar, "Add a Trading 212 account"). They are then stored encrypted.
# Or set them here, one pair per account type (read-only API keys from the Trading 212 app: Settings, API).
T212_ISA_KEY=
T212_ISA_SECRET=
T212_INVEST_KEY=
T212_INVEST_SECRET=
T212_PARTNER_ISA_KEY=
T212_PARTNER_ISA_SECRET=

# --- Transfers between your own accounts (optional but recommended) -----------------------------------
# Text that always means "money moved between my own accounts", as regular expressions separated by |||
# Example: TRANSFER TO MR J SMITH|||REGULAR TRANSFER PAYMENT TO ACCOUNT SAVING
FT_TRANSFER_PATTERNS=

# --- Optional AI categorisation (OFF unless you set a backend and use the Auto-categorise tab) ------------
# The free local dictionary needs none of this. Only cleaned merchant names are sent, after a preview.
# Words that must NEVER be sent (your surname, first names, partner's name), comma separated.
FT_OWN_NAMES=
FT_LLM_BACKEND=anthropic
FT_ANTHROPIC_API_KEY=
# Only if you deliberately use a company LLM gateway (check your employer allows personal data there):
FT_GATEWAY_BASE_URL=
FT_GATEWAY_TOKEN=
FT_LLM_MODEL=
